algoritmo "Somador"

var
    valor, S: Inteiro
    resp: Caractere

inicio
    S <- 0
    resp <- "S"

 repita
        Escreva("Digite valor ==> ")
        Leia(valor)

        S <- S + valor

        Escreval("Voce quer continuar? [S/N]")
        Leia(resp)
 ate (resp = "N")

    Escreval("A soma de todos os valores digitados e ", S)

fimalgoritmo